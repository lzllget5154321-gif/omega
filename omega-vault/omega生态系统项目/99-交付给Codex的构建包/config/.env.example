# Omega 环境变量模板
# ==================
# ⚠️ 这不是真实的 .env 文件——这是模板。Codex 必须在构建前按 api_tiers.yaml 协议确认可用 API。
#
# Codex 的行为规则（强制执行）：
# 1. 读取此文件，识别所有标记为 [REQUIRED] 的变量
# 2. 部署时按 api_tiers.yaml 协议确认 Codex 会话、OpenAI 与备用 provider；
#    OpenRouter/国产 Claude Messages 仅作备用，禁止原生 Anthropic API。
#    → 生成 active_engines.yaml（记录 available / deferred / unavailable_confirmed）
# 3. 至少一个运行时语言引擎 Key 可用，否则 Omega 运行时无法完成语言任务
# 4. 禁止将任何密钥/Token/密码写入代码文件、提交到 Git、或打印到日志
# 5. 所有敏感值仅从环境变量或 .env 文件读取
#
# 复制此文件为 .env 并填入真实值：
#   copy .env.example .env

# ═══════════════════════════════════════════
# 语言引擎（功能最佳优先——部署时逐层确认可用性）
# ═══════════════════════════════════════════

# [PRIMARY-OPTIONAL] OpenAI API — Omega 运行时次主链（构建主链使用 Codex 当前会话）
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# 可选固定覆盖；留空时通过 /v1/models 动态发现，未知 ID 必须原样保留
OMEGA_OPENAI_MODEL=

# [FALLBACK-OPTIONAL] OpenRouter Claude Messages（非 Anthropic 原生账号）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OMEGA_OPENROUTER_MODEL=

# [FALLBACK-OPTIONAL] 国产 Claude Messages 兼容端点
# DOMESTIC_CLAUDE_BASE_URL 禁止设置为 https://api.anthropic.com
DOMESTIC_CLAUDE_API_KEY=
DOMESTIC_CLAUDE_BASE_URL=
OMEGA_DOMESTIC_CLAUDE_MODEL=

# [FALLBACK-CANDIDATE] DeepSeek API Key — 国内 OpenAI-compatible 候选
# 获取: https://platform.deepseek.com/api_keys
# 仅在健康检查和任务能力门禁通过后参与备用路由；不进入语言主链
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OMEGA_DEEPSEEK_MODEL=

# ═══════════════════════════════════════════
# 实时搜索（可选增强——没有不影响核心功能）
# ═══════════════════════════════════════════

# [BEST-OPTIONAL] Perplexity API Key — 实时搜索+来源引用
# 获取: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# [BEST-OPTIONAL] Brave Search API Key — 免费搜索备选
# 获取: https://brave.com/search/api/
BRAVE_API_KEY=

# ═══════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════

# [REQUIRED] PostgreSQL 密码（Omega 本地数据库）
# 设置: 任意强密码，至少 16 位
POSTGRES_PASSWORD=

# [OPTIONAL] Qdrant API Key（本地部署不需要，仅远程 Qdrant 时需要）
QDRANT_API_KEY=

# ═══════════════════════════════════════════
# 学术检索
# ═══════════════════════════════════════════

# [OPTIONAL] NCBI API Key（PubMed Entrez API，无 Key 时限速 3 req/s）
# 获取: https://www.ncbi.nlm.nih.gov/account/ → API Key Management
NCBI_API_KEY=

# [OPTIONAL] NCBI 邮箱（PubMed API 要求提供联系邮箱，建议填写）
NCBI_EMAIL=

# [OPTIONAL] Semantic Scholar API Key（免费 API）
# 获取: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ═══════════════════════════════════════════
# 文献与代码平台
# ═══════════════════════════════════════════

# [OPTIONAL] Zotero API Key（程序化访问本地 Zotero 文献库）
# 获取: Zotero 桌面版 → Edit → Settings → Feeds/API → Create new private key
ZOTERO_API_KEY=

# [OPTIONAL] Zotero User ID（与 API Key 配对使用）
# 获取: https://www.zotero.org/settings/keys
ZOTERO_USER_ID=

# [OPTIONAL] GitHub Personal Access Token（GitHub MCP Server）
# 获取: https://github.com/settings/tokens → Generate new token (classic) → 勾选 repo + workflow
GITHUB_TOKEN=

# ═══════════════════════════════════════════
# 国内 AI 扩展（阶段 2 预留——现在填了以后不用再配置）
# ═══════════════════════════════════════════

# [OPTIONAL-DOMESTIC] 通义千问 API Key（阿里云，国内多模态平台）
QWEN_API_KEY=
QWEN_BASE_URL=
OMEGA_QWEN_MODEL=

# [OPTIONAL-DOMESTIC] 智谱 GLM API Key（国内平台）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=
OMEGA_ZHIPU_MODEL=

# [OPTIONAL-DOMESTIC] 月之暗面 Kimi API Key（国内平台，超长上下文）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
OMEGA_MOONSHOT_MODEL=

# [OPTIONAL-DOMESTIC] 硅基流动 API Key（国内平台，多模型聚合）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
OMEGA_SILICONFLOW_MODEL=

# [DISASTER-RECOVERY-ONLY] 本地模型默认关闭；仅用户明确启用时使用
OMEGA_LOCAL_DR_ENABLED=false
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234

# ═══════════════════════════════════════════
# 系统
# ═══════════════════════════════════════════

# [OPTIONAL] Omega 日志级别（DEBUG, INFO, WARNING, ERROR）
OMEGA_LOG_LEVEL=INFO

# [OPTIONAL] Omega 工作模式（function_first | safety_first | balanced）
OMEGA_MODE=function_first
